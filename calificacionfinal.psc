Algoritmo calificacionfinal
		Definir ingles, desarrollo, matematicas, redes Como Real;
		Definir fisica, programacion, comunicacion, taekwondo Como Real;
		Escribir "Calificacion de Ingles 1:";
		Leer ingles;
		Si ingles < 1 O ingles > 10 Entonces
			Escribir "Ingles 1: Calificacion invalida";
		Sino
			Si ingles >= 8 Entonces
				Escribir "Ingles 1: Aprobado";
			Sino
				Escribir "Ingles 1: Reprobado";
			FinSi
		FinSi
		
